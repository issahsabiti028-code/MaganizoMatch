<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>SongMate Pro - Auto Studio</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{background:#0a0a14;color:#fff;font-family:system-ui}
.header{background:linear-gradient(90deg,#1a1033,#2d1b69);padding:12px;text-align:center;border-bottom:2px solid #a855f7;position:sticky;top:0;z-index:20}
.tabs{display:flex;overflow-x:auto;gap:6px;padding:10px;background:#141428;position:sticky;top:60px;z-index:19}
.tab{white-space:nowrap;padding:10px 16px;border-radius:20px;background:#1e1e3a;border:1px solid #333;cursor:pointer;font-size:13px;font-weight:bold}
.tab.active{background:linear-gradient(90deg,#a855f7,#ec4899)}
.panel{display:none;padding:14px}.panel.active{display:block}
.card{background:#1a1a35;border:1px solid #2a2a4a;border-radius:16px;padding:14px;margin-bottom:12px}
.btn{width:100%;padding:14px;border:none;border-radius:12px;font-weight:bold;cursor:pointer;font-size:15px;margin-top:8px}
.btn-primary{background:linear-gradient(90deg,#a855f7,#ec4899);color:#fff}
.btn-dark{background:#252545;color:#fff;border:1px solid #444}
.btn-success{background:linear-gradient(90deg,#10b981,#059669);color:#fff}
.timer{font-size:42px;font-weight:900;text-align:center;color:#a855f7}
.progress{height:8px;background:#252545;border-radius:10px;overflow:hidden;margin:10px 0}
.bar{height:100%;width:0%;background:linear-gradient(90deg,#a855f7,#ec4899);transition:width .3s}
.songItem{background:#141432;border:1px solid #2a2a5a;padding:12px;border-radius:12px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center}
.status{padding:10px;border-radius:10px;text-align:center;margin:10px 0;font-size:13px}
.status.ok{background:#052e1f;color:#10b981;border:1px solid #10b981}
.status.warn{background:#332100;color:#f59e0b;border:1px solid #f59e0b}
audio{width:100%;margin-top:8px}
</style>
</head>
<body>
<div class="header">
<h2>🎵 SONGMATE PRO STUDIO</h2>
<div style="font-size:11px;opacity:.7">Auto Make • Released Songs • 0.5-10min Voice</div>
</div>
<div class="tabs">
<div class="tab active" data-t="make">🎹 Make</div>
<div class="tab" data-t="voice">🎙️ Voice 10min</div>
<div class="tab" data-t="type">⌨️ Type Auto</div>
<div class="tab" data-t="hear">🎧 Hear All Songs</div>
</div>

<div class="panel active" id="p-make">
<div class="card">
<h3>Beat Maker - Auto Mix ON</h3>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
<button class="btn btn-dark" onclick="playBeat('afro')">Afro Beat</button>
<button class="btn btn-dark" onclick="playBeat('trap')">Trap Beat</button>
<button class="btn btn-dark" onclick="playBeat('amapiano')">Amapiano</button>
<button class="btn btn-dark" onclick="playBeat('dancehall')">Dancehall</button>
</div>
<button class="btn btn-primary" onclick="stopBeat()">⏹️ Stop Beat</button>
<div style="margin-top:10px">BPM <span id="bpmV">90</span> <input type="range" id="bpm" min="60" max="160" value="90" oninput="document.getElementById('bpmV').innerText=this.value"></div>
<label style="margin-top:10px;display:block"><input type="checkbox" id="autoMix" checked> ✅ Auto-Mix Voice + Beat when recording stops</label>
</div>
</div>

<div class="panel" id="p-voice">
<div class="card">
<h3>🎙️ Voice Studio - Auto Make</h3>
<div id="micStatus" class="status ok">✅ Mic Ready</div>
<div class="timer" id="timer">00:00 / 10:00</div>
<div class="progress"><div class="bar" id="bar"></div></div>
<div style="display:flex;justify-content:space-between;font-size:11px;opacity:.7"><span>Min 0:30</span><span id="currLen">0:00</span><span>Max 10:00</span></div>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px"><button class="btn btn-primary" id="recBtn" onclick="toggleRec()">🔴 Start Recording</button><button class="btn btn-dark" id="playBtn" onclick="playVoice()" disabled>▶️ Play Voice</button></div>
<div id="voiceWrap" style="display:none"><audio id="voiceAudio" controls></audio></div>
<div class="card" style="margin-top:12px;background:#0f0f2a"><h4>🎵 Auto Final Song</h4><div id="finalWrap" style="display:none"><audio id="finalAudio" controls></audio><button class="btn btn-success" onclick="downloadSong()">⬇️ DOWNLOAD FINAL SONG</button><button class="btn btn-dark" style="background:#6366f1" onclick="downloadVoice()">⬇️ DOWNLOAD VOICE ONLY</button><button class="btn btn-dark" onclick="saveToLibrary()">💾 SAVE TO HEAR LIBRARY</button></div><div id="autoMsg" style="font-size:12px;opacity:.7;text-align:center;margin-top:6px">Auto mix will happen after you stop recording</div></div>
</div>
</div>

<div class="panel" id="p-type">
<div class="card">
<h3>⌨️ Type Auto - Makes Song While Typing</h3>
<textarea id="lyrics" style="width:100%;height:120px;background:#0f0f23;color:#fff;border:1px solid #a855f7;border-radius:12px;padding:12px;font-size:16px" placeholder="Type lyrics here... e.g. I love you baby you are my star... Song will auto create as you type!"></textarea>
<div style="display:flex;gap:8px;margin-top:8